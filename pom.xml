<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 2.7 is compatible with Java 11; Spring Boot 3.x is not. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>io.github.mbesoft</groupId>
    <artifactId>bp-teams-notifier</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>bp-teams-notifier</name>
    <description>Send Adaptive Card notifications to Microsoft Teams through an OAuth2-secured gateway.</description>

    <properties>
        <java.version>11</java.version>
        <!-- Enforce Java 11 bytecode and APIs even when built with a newer JDK. -->
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Spring 5 HTTP client support and Jackson JSON serialization. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- javax.validation APIs used by Spring Boot 2.7. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Isolated JUnit/Mockito unit tests (no external HTTP calls). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Keep the root Designer JSON as the single runtime template. -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>broker-voting-campaign-adaptive-card.json</include>
                </includes>
                <targetPath>cards</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
